{
  "name": "gisela-ugc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run video:catalog && npm run service:entrypoints && npm run fonts:entrypoints && npm run client:entrypoints",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "prebuild:dev": "npm run video:catalog && npm run service:entrypoints",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.cjs",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.cjs",
    "lighthouse:matrix": "npm run lighthouse:mobile && npm run lighthouse:desktop",
    "check:mobile-regression": "node scripts/mobile-regression-check.mjs",
    "preview": "vite preview",
    "service:entrypoints": "node scripts/enrich-service-entrypoints.mjs",
    "fonts:entrypoints": "node scripts/normalize-entrypoint-fonts.mjs",
    "client:entrypoints": "node scripts/normalize-client-entrypoints.mjs",
    "fonts:subsets": "bash scripts/generate-font-subsets.sh",
    "video:encode": "bash scripts/encode-videos.sh",
    "video:encode:dry": "bash scripts/encode-videos.sh --dry-run",
    "video:hls": "bash scripts/encode-hls.sh",
    "video:hls:dry": "bash scripts/encode-hls.sh --dry-run",
    "video:service-posters": "bash scripts/generate-service-posters.sh",
    "video:responsive-posters": "bash scripts/generate-responsive-posters.sh",
    "video:startups": "node scripts/generate-startup-videos.mjs",
    "video:catalog": "node scripts/generate-nuevos-r2-catalog.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.3.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "autoprefixer": "^10.4.20",
    "beasties": "^0.4.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.2.4",
    "vitest": "^4.1.8"
  }
}
