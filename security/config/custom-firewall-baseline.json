{
  "rules": [
    {
      "ref": "block-unexpected-methods",
      "description": "[giseugc-cost] Block unexpected methods",
      "expression": "(not http.request.method in {\"GET\" \"HEAD\" \"OPTIONS\"})",
      "action": "block",
      "enabled": true
    },
    {
      "ref": "block-common-exploit-paths",
      "description": "[giseugc-cost] Block common exploit paths",
      "expression": "(lower(http.request.uri.path) matches \"^/(wp-admin|wp-login\\\\.php|xmlrpc\\\\.php|\\\\.env|\\\\.git|vendor/phpunit|boaform|cgi-bin).*\" and not cf.client.bot)",
      "action": "block",
      "enabled": true
    }
  ]
}
