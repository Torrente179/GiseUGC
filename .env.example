# Cloudflare R2 media upload
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name

# Optional public contact links
VITE_WHATSAPP_URL=https://wa.me/your-number
VITE_TELEGRAM_URL=https://t.me/your-handle
# Canonical Fiverr profile — no tracking query
VITE_FIVERR_URL=https://www.fiverr.com/gisela_sm
